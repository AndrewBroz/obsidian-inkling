{
	"extends": "@tsconfig/svelte/tsconfig.json",
	"compilerOptions": {
		"baseUrl": "./src",
		"inlineSources": false,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"target": "ESNext",
		"allowJs": false,
		"noImplicitAny": true,
		"esModuleInterop": true,
		"importHelpers": true,
		"verbatimModuleSyntax": true,
		"strict": true,
		"paths": {
			"src": [
				"src/*",
				"tests/*"
			],
			// obsidian-typings' declarations are CommonJS, so they resolve these packages' "require"
			// entry. Without a .d.cts beside it they'd be untyped, and with one they'd be a second
			// copy of each module that doesn't match the ESM one. Both kinds share the ESM types.
			"@codemirror/state": ["../node_modules/@codemirror/state/dist/index.d.ts"],
			"@codemirror/view": ["../node_modules/@codemirror/view/dist/index.d.ts"],
			"@codemirror/language": ["../node_modules/@codemirror/language/dist/index.d.ts"],
			"@codemirror/search": ["../node_modules/@codemirror/search/dist/index.d.ts"]
		},
		"lib": [
			"dom",
			"ESNext"
		],
		"types": [
			"jest",
			"svelte",
			"node",
			"obsidian-typings"
		]
	},
	"files": [
		"node_modules/jest-expect-message/types/index.d.ts"
	],
	"include": [
		"**/**.ts",
		"src/**/*.svelte"
	],
	// The e2e suite has its own tsconfig (test/e2e/tsconfig.json): mocha's and wdio's globals clash with jest's.
	// Setting `exclude` replaces the default, so node_modules is listed again.
	"exclude": [
		"node_modules",
		"test/e2e",
		"wdio.conf.mts"
	]
}
