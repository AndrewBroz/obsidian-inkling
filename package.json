{
	"name": "obsidian-inkling",
	"version": "0.15.1",
	"type": "module",
	"description": "A CriticMarkup plugin for Obsidian",
	"main": "main.js",
	"packageManager": "bun@1.3.14",
	"scripts": {
		"dev": "bun scripts/build/esbuild.config.ts development && obsidian plugin:reload id=inkling-markup",
		"build": "bun run tsc -noEmit -skipLibCheck && bun scripts/build/esbuild.config.ts production",
		"build:dev": "bun run tsc -noEmit -skipLibCheck && bun scripts/build/esbuild.config.ts development",
		"build:dev:hr": "bun run tsc -noEmit -skipLibCheck && bun scripts/build/esbuild.config.ts development && obsidian plugin:reload id=inkling-markup",
		"lint": "bun eslint . && bun run typecheck:e2e",
		"typecheck:e2e": "tsc -noEmit -p test/e2e/tsconfig.json",
		"format": "bun dprint fmt",
		"test": "jest --verbose",
		"test:e2e": "nice -n 19 node node_modules/.bin/wdio run ./wdio.conf.mts",
		"sandbox": "bash scripts/obsidian-sandbox/obsidian-sandbox.sh",
		"release-patch": "bun run scripts/release/bump-version.ts --type patch",
		"release-minor": "bun run scripts/release/bump-version.ts --type minor",
		"release-major": "bun run scripts/release/bump-version.ts --type major",
		"release-beta": "bun run scripts/release/bump-version.ts --beta",
		"postinstall": "bun run scripts/postinstall.ts"
	},
	"keywords": [],
	"author": "Andrew Brož (https://github.com/AndrewBroz)",
	"contributors": [
		"kometenstaub (https://github.com/kometenstaub)",
		"Fevol (https://github.com/Fevol)"
	],
	"license": "MIT",
	"devDependencies": {
		"@codemirror/commands": "6.8.1",
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@lezer/generator": "^1.8.1",
		"@tsconfig/svelte": "^5.0.9",
		"@types/bun": "^1.4.4",
		"@types/diff-match-patch": "^1.0.36",
		"@types/jest": "^30.0.0",
		"@types/mocha": "10.0.10",
		"@types/node": "^26.6.6",
		"@wdio/cli": "10.2.0",
		"@wdio/globals": "10.2.0",
		"@wdio/local-runner": "10.2.0",
		"@wdio/mocha-framework": "10.2.0",
		"@wdio/spec-reporter": "10.2.0",
		"commander": "^15.1.0",
		"commonmark": "0.31.2",
		"dprint": "^0.55.2",
		"esbuild": "^0.28.2",
		"esbuild-sass-plugin": "^3.7.0",
		"esbuild-svelte": "^0.9.5",
		"eslint": "^10.15.0",
		"eslint-plugin-obsidianmd": "0.6.0",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"jest": "^30.5.2",
		"jest-environment-jsdom": "^30.5.2",
		"jest-expect-message": "^1.1.3",
		"jsdom": "^26.1.0",
		"mocha": "12.0.3",
		"obsidian": "^1.14.4",
		"obsidian-typings": "^6.60.0",
		"svelte": "^5.58.0",
		"svelte-eslint-parser": "^1.10.1",
		"svelte-preprocess": "^6.0.5",
		"ts-jest": "^29.4.15",
		"tslib": "^2.9.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.73.0",
		"wdio-obsidian-reporter": "3.5.0",
		"wdio-obsidian-service": "3.5.0",
		"webdriverio": "10.2.0"
	},
	"dependencies": {
		"@codemirror/language": "github:fevol-forks/cm-language",
		"@codemirror/search": "^6.7.2",
		"@fevol/lang-criticmarkup": "^2.1.0",
		"@flatten-js/interval-tree": "^1.1.4",
		"@lezer/common": "1.2.3",
		"diff-match-patch": "^1.0.5",
		"entities": "6.0.1",
		"localforage": "^1.10.0",
		"localforage-getitems": "github:conversejs/localForage-getItems",
		"localforage-setitems": "^1.4.0",
		"monkey-around": "^3.0.0",
		"svelty-picker": "^6.1.6"
	},
	"overrides": {
		"glob": "^14.0.6",
		"obsidian": "$obsidian",
		"@lezer/common": "1.2.3",
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@codemirror/language": "$@codemirror/language"
	},
	"trustedDependencies": []
}
