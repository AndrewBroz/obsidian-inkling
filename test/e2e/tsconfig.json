{
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "bundler",
		"target": "ES2022",
		"strict": true,
		"noImplicitAny": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"types": ["node", "mocha", "@wdio/globals/types", "wdio-obsidian-service", "obsidian-typings"]
	},
	"include": ["./**/*.ts", "../../wdio.conf.mts"]
}
